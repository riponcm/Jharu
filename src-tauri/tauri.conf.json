{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jharu",
  "version": "0.1.0",
  "identifier": "com.riponcm.jharu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jharu",
        "width": 1100,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzRjBDOTFFRkE1OURDNTEKUldSUjNGbjZIc253SThXTW1MRjJ6WFpQbitSY1l0MFN4M0dzeGlGUmRGR1YwK0dpOFNiTk11TzEK",
      "endpoints": [
        "https://github.com/riponcm/Jharu/releases/latest/download/latest.json"
      ]
    }
  }
}